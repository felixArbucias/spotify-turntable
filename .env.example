# Written by `npx spotify-turntable auth` — or fill in by hand. Never commit the real values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: what to play when you're not playing anything.
# A playlist link/ID owned by the same account, or `liked` for your Liked Songs.
SPOTIFY_FALLBACK_PLAYLIST=
